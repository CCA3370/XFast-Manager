{
  "name": "xfast-manager",
  "version": "1.3.0",
  "description": "XFast Manager - X-Plane Addon Auto Manager",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/install-rollup-native.js",
    "predev": "node scripts/generate-changelog-bundle.mjs && node scripts/validate-i18n.mjs",
    "prebuild": "node scripts/generate-changelog-bundle.mjs && node scripts/validate-i18n.mjs && npm run typecheck",
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "lint:i18n": "node scripts/validate-i18n.mjs",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "tauri": "tauri",
    "tauri:dev": "tauri dev -- -- --xcsldev",
    "tauri:build": "tauri build",
    "generate:icon": "png-to-ico src-tauri/icons/icon.png > src-tauri/icons/icon.ico"
  },
  "keywords": [
    "tauri",
    "x-plane",
    "installer"
  ],
  "author": "3370Tech",
  "license": "GPL-3.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^2.10.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^25.0.2",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.7",
    "vitest": "^4.1.10",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vueuse/core": "^14.1.0",
    "gsap": "^3.12.5",
    "leaflet": "^1.9.4",
    "marked": "^17.0.3",
    "pinia": "^3.0.4",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.4",
    "glob@>=9.0.0 <14.0.2": "^14.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
